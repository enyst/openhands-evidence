  "consistent_order": true,
  "persisted_before_user_callback": true,
  "persisted_before_visualizer": false,
  "failed_write_error": "OSError: disk full (simulated)",
  "delivered_before_failure": [
    "SystemPromptEvent",
    "MessageEvent"
  ],
  "delivered_after_failure": [],
  "_exit": 0,
  "_seconds": 5.1,
  "checks": [
    {
      "check": "order_first_event.0 eq visualizer",
      "ok": true,
      "actual": "visualizer"
    },
    {
      "check": "order_first_event.1 eq first",
      "ok": true,
      "actual": "first"
    },
    {
      "check": "order_first_event.2 eq second",
      "ok": true,
      "actual": "second"
    },
    {
      "check": "consistent_order eq true",
      "ok": true,
      "actual": "true"
    },
    {
      "check": "every_event_delivered eq true",
      "ok": true,
      "actual": "true"
    },
    {
      "check": "persisted_before_user_callback eq true",
      "ok": true,
      "actual": "true"
    },
    {
      "check": "persisted_before_visualizer eq false",
      "ok": true,
