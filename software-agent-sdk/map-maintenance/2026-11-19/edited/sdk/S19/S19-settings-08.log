  --check resolve.mcp len-eq 1 --check resolve.all_mcp len-eq 2 --check resolve.none_mcp len-eq 0 \
  --check resolve.skills len-eq 1 --check resolve.skills contains deploy --check resolve.persona eq Pirate \
