    },
    {
      "check": "deprecated_warned.bash eq true",
      "ok": true,
      "actual": "true"
    },
    {
      "check": "description_lists.general-purpose eq true",
      "ok": true,
      "actual": "true"
    },
    {
      "check": "description_lists.web-researcher eq true",
      "ok": true,
