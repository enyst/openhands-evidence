$ export SDK_VERIFY_RUN=$(control-sdk new --field run)
control-sdk program S06/condense --arg overflow \
  --check with_error missing --check with_status eq finished --check with_requests eq 1 \
  --check with_condensations eq 1 --check summary_reached_agent eq true \
  --check without_status eq error --check without_requests eq 0 \
  --check without_error_events eq '["LLMContextWindowExceedError"]'
{
  "ok": true,
  "mode": "overflow",
  "with_error": null,
  "with_status": "finished",
  "with_requests": 1,
  "with_condensations": 1,
  "with_error_events": [],
  "without_error": "ConversationRunError",
  "without_status": "error",
  "without_requests": 0,
  "without_condensations": 0,
  "without_error_events": [
    "LLMContextWindowExceedError"
  ],
  "summary_reached_agent": true,
  "_exit": 0,
  "_seconds": 6.0,
  "checks": [
    {
      "check": "with_error missing",
      "ok": true,
      "actual": "null"
    },
    {
      "check": "with_status eq finished",
      "ok": true,
      "actual": "finished"
    },
    {
      "check": "with_requests eq 1",
      "ok": true,
      "actual": "1"
    },
    {
      "check": "with_condensations eq 1",
      "ok": true,
      "actual": "1"
    },
    {
      "check": "summary_reached_agent eq true",
      "ok": true,
      "actual": "true"
    },
    {
      "check": "without_status eq error",
      "ok": true,
      "actual": "error"
    },
    {
      "check": "without_requests eq 0",
      "ok": true,
      "actual": "0"
    },
    {
      "check": "without_error_events eq [\"LLMContextWindowExceedError\"]",
      "ok": true,
      "actual": "[\"LLMContextWindowExceedError\"]"
    }
  ]
}

[exit 0 after 6s]
