    },
    {
      "check": "first_run.agent_cost eq 0.28",
      "ok": true,
      "actual": "0.28"
    },
    {
      "check": "first_run.secondary_cost eq 0.14",
      "ok": true,
      "actual": "0.14"
    },
    {
      "check": "first_run.combined_cost eq 0.42",
      "ok": true,
      "actual": "0.42"
    },
    {
      "check": "first_run.combined_prompt_tokens eq 300",
      "ok": true,
      "actual": "300"
    },
    {
      "check": "resumed.restored_agent_cost eq 0.28",
      "ok": true,
      "actual": "0.28"
    },
    {
      "check": "resumed.agent_cost_after eq 0.42",
