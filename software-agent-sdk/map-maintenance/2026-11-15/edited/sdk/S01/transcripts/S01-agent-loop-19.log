  "checks": [
    {
      "check": "status eq finished",
      "ok": true,
      "actual": "finished"
    },
    {
      "check": "facts_type eq ProjectFacts",
      "ok": true,
      "actual": "ProjectFacts"
    },
    {
      "check": "facts len-eq 3",
      "ok": true,
      "actual": "[\"one\", \"two\", \"three\"]"
    },
    {
      "check": "rationale_type eq CommandRationale",
      "ok": true,
      "actual": "CommandRationale"
    },
    {
      "check": "rationale_purpose eq see the files",
      "ok": true,
      "actual": "see the files"
    },
    {
      "check": "finish_schema_fields contains facts",
      "ok": true,
      "actual": "[\"description\", \"facts\", \"message\", \"summary\"]"
    },
    {
      "check": "finish_schema_fields contains message",
      "ok": true,
      "actual": "[\"description\", \"facts\", \"message\", \"summary\"]"
    },
    {
      "check": "rejected.reserved_name eq ValueError",
      "ok": true,
      "actual": "ValueError"
    },
    {
      "check": "rejected.field_collision eq ValueError",
      "ok": true,
      "actual": "ValueError"
    }
  ]
