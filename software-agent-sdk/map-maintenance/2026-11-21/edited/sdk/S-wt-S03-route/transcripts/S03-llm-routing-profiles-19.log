      "ok": true,
      "actual": "RouterLLM"
    },
    {
      "check": "by_route.selection.mode eq manual",
      "ok": true,
      "actual": "manual"
    },
    {
      "check": "by_route.selection.manual_route_name eq strong",
      "ok": true,
      "actual": "strong"
    },
    {
      "check": "by_route.requests.strong eq 1",
      "ok": true,
      "actual": "1"
    },
    {
      "check": "by_route.classifier_saw_routes eq true",
      "ok": true,
      "actual": "true"
    },
    {
      "check": "by_route.observation.text contains switched to RouterLLM route 'strong'",
      "ok": true,
      "actual": "Classified task as 'route: strong' and switched to RouterLLM route 'strong' (model 'openai/gpt-4.1'). Future agent steps will use this route."
    },
