      "ok": true,
      "actual": "true"
    },
    {
      "check": "unknown.observation.text contains did not resolve to an available RouterLLM route",
      "ok": true,
      "actual": "[An error occurred during execution.]\nClassifier reply did not resolve to an available RouterLLM route (reply: '{\"route\": \"nonexistent\"}'); refusing to silently route to a default. Retry the tool or u"
