    "requests": {
      "planner": 2,
      "classifier": 1,
      "strong": 0
    },
    "classifier_saw_routes": true,
    "observation": {
      "tool": "route_task_to_model",
      "error": true,
      "text": "[An error occurred during execution.]\nClassifier reply did not resolve to an available RouterLLM route (reply: '{\"route\": \"nonexistent\"}'); refusing to silently route to a default. Retry the tool or u"
    }
  },
  "_exit": 0,
  "_seconds": 9.5,
  "checks": [
    {
