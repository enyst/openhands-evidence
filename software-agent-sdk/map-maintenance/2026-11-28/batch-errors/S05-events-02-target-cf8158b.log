$ export SDK_VERIFY_RUN=$(control-sdk new --field run)
CID=$(control-sdk conversation new --script-json '[{"tools":[{"tool":"terminal","args":{"command":"echo one"}},{"tool":"file_editor","args":{"command":"view"}},{"tool":"terminal","args":{"command":"echo three"}}]},{"finish":"done"}]' --field id)
control-sdk conversation send "$CID" --text "Run the three tools" --run --check execution_status eq finished
control-sdk program S05/batch_errors --arg "$CID" \
  --check batch_calls eq 3 --check rejected_calls eq 1 --check error_matches_rejected eq true \
  --check batch_assistant_messages eq 1 --check batch_assistant_tool_calls eq 3 \
  --check answered_right_after eq true --check every_call_answered_in_order eq true \
  --check view_cuts_inside_batch eq 0
